# Local secrets (keep the shared configuration template)
.env
.env.*
!.env.example

# Python virtual environments and bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Test, lint and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python build artifacts
*.egg-info/
build/
dist/
.eggs/

# Local logs and editor/OS files
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Raw inference responses (keep evaluation reports versionable)
evaluation/results/*/raw.jsonl
evaluation/results/tests.xml
**/raw.jsonl
evaluation/experiments/**/tests.xml

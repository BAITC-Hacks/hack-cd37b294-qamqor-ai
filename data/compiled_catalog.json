  "system_intents": [
    {
      "id": "SYS_OUT_OF_SCOPE",
      "description": "Request is not about Saqta insurance services (loans, weather, jobs, life insurance which is not offered).",
      "behavior": "Say politely that Saqta cannot help with this, suggest what the bot can do.",
      "response": {
        "ru": "С этим я, к сожалению, не помогу. Могу подсказать по страховке авто, здоровья, жилья и поездок.",
        "kk": "Өкінішке қарай, бұл сұраққа көмектесе алмаймын. Көлік, денсаулық, тұрғын үй және сапар сақтандыруы бойынша көмектесемін."
      }
    },
    {
      "id": "SYS_UNCLEAR",
      "description": "Intent cannot be determined with enough confidence.",
      "behavior": "Ask one short clarifying question, offering the 2 most likely options.",
      "response": {
        "ru": "Уточните, пожалуйста: вы хотите {option_a} или {option_b}?",
        "kk": "Нақтылап жіберіңізші: {option_a} керек пе, әлде {option_b} ме?"
      }
    },
    {
      "id": "SYS_GOODBYE",
      "description": "Client ends the conversation.",
      "behavior": "Thank and close.",
      "response": {
        "ru": "Спасибо за обращение! Хорошего дня.",

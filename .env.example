OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CALLAI_MODEL=gpt-6-astra
CALLAI_TIMEOUT_SECONDS=90
CALLAI_EVAL_CONCURRENCY=2
# Optional override; default uses bundled golden/L2/case_2/voice_router_dataset
CALLAI_DATASET_PATH=
# Optional audio key/base URL; defaults reuse OPENAI configuration.
CALLAI_VOICE_ENABLED=true
CALLAI_VOICE_API_KEY=
CALLAI_VOICE_BASE_URL=
CALLAI_STT_MODEL=whisper-1
CALLAI_TTS_MODEL=gpt-4o-mini-tts
CALLAI_TTS_VOICE=coral
# Speech-only overrides; legacy CALLAI_TTS_* above remain valid fallbacks.
# Compare /voice_samples/index.html before selecting a different demo voice.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_RU=marin
TTS_VOICE_KK=marin
TTS_SPEED=1.0
# Optional extra style guidance, appended to the language-specific call-center style.
TTS_INSTRUCTIONS=
# CALLAI_DATABASE=C:/path/to/local-callai.sqlite
# Experimental standalone adapter; the web backend never starts it.
# Missing flag also means disabled. See experimental/asterisk/SETUP.md.
TELEPHONY_ENABLED=false
